# CINEMA AI DUB configuration
# Copy to .env in the project root and edit as needed.

APP_NAME=CINEMA AI DUB
ENVIRONMENT=development
MAX_UPLOAD_MB=2048
UPLOAD_CHUNK_MB=8
UPLOAD_SESSION_TTL_HOURS=24
THUMBNAIL_COUNT=6
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska,video/x-msvideo,video/ogg
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FFPROBE_BINARY=

# Phase 4 — audio extraction and separation
# auto: prefer Demucs if installed, else remote if configured, else built-in DSP
# dsp: CPU-only built-in estimator (no model download)
# demucs: local open-source model; install torch/torchaudio/demucs first
# remote: POST multipart WAV to REMOTE_SEPARATION_URL and download four stems
SEPARATION_BACKEND=auto
AUDIO_EXTRACT_FORMAT=wav
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
MODEL_CACHE_DIR=
REMOTE_SEPARATION_URL=
REMOTE_SEPARATION_TOKEN=

# Phase 6 — speech recognition and dialogue transcription
# auto: use faster-whisper when installed, else remote when configured
# faster-whisper: local open-source CTranslate2 model, CPU int8 by default
# remote: POST audio JSON to TRANSCRIPTION_REMOTE_URL (only if explicitly configured)
TRANSCRIPTION_BACKEND=auto
TRANSCRIPTION_MODEL=tiny
TRANSCRIPTION_DEVICE=auto
TRANSCRIPTION_COMPUTE_TYPE=auto
TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_WORD_TIMESTAMPS=true
TRANSCRIPTION_VAD_FILTER=true
TRANSCRIPTION_MODEL_CACHE_DIR=
TRANSCRIPTION_REMOTE_URL=
TRANSCRIPTION_REMOTE_TOKEN=

# Phase 7 — speaker diarization and visual association
# auto: use local Silero VAD + SpeechBrain ECAPA-TDNN + scikit-learn clustering
# local: require the local open-source stack
# remote: POST audio to DIARIZATION_REMOTE_URL (only if explicitly configured)
DIARIZATION_BACKEND=auto
DIARIZATION_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_DEVICE=auto
DIARIZATION_VAD_THRESHOLD=0.5
DIARIZATION_MIN_SPEECH_MS=250
DIARIZATION_MIN_SILENCE_MS=200
DIARIZATION_MIN_TURN_MS=350
DIARIZATION_MAX_CHUNK_S=5.0
DIARIZATION_CLUSTER_DISTANCE=0.70
DIARIZATION_MATCH_THRESHOLD=0.72
DIARIZATION_REVIEW_THRESHOLD=0.62
DIARIZATION_MATCH_MARGIN=0.06
DIARIZATION_MODEL_CACHE_DIR=
DIARIZATION_REMOTE_URL=
DIARIZATION_REMOTE_TOKEN=

# auto: use OpenCV Haar cascades when cv2 and ffmpeg are available
# opencv: require local OpenCV detection
# none: disable visual candidate detection
VISUAL_DETECTION_BACKEND=auto
VISUAL_DETECTOR_MODEL=haarcascade_frontalface_default
VISUAL_MAX_CANDIDATES=24
VISUAL_FRAME_WIDTH=480

# Phase 8 — context-aware translation (open-source models only; no paid APIs)
# auto | indictrans2 | nllb | madlad | remote
#   auto = IndicTrans2 if already downloaded (MIT), else NLLB-200 (CC-BY-NC-4.0, non-commercial)
TRANSLATION_BACKEND=auto
TRANSLATION_NLLB_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
TRANSLATION_MADLAD_MODEL=google/madlad400-3b-mt
# auto | cpu | cuda
TRANSLATION_DEVICE=auto
# int8 dynamic quantisation on CPU: ~3.5x faster, slightly lower quality
TRANSLATION_CPU_QUANTIZE=false
TRANSLATION_NUM_BEAMS=4
TRANSLATION_BATCH_SIZE=8
TRANSLATION_SCENE_GAP_MS=6000
TRANSLATION_COMFORTABLE_SYLLABLES_PER_S=5.5
TRANSLATION_MODEL_CACHE_DIR=
# Self-hosted GPU worker: POST {url}/translate {texts, source, target} -> {translations}
TRANSLATION_REMOTE_URL=
TRANSLATION_REMOTE_TOKEN=
# Optional self-hosted open LLM (OpenAI-compatible, e.g. Ollama http://localhost:11434/v1)
# that rewrites drafts with full scene/character context. Leave empty to disable.
TRANSLATION_REFINER_URL=
TRANSLATION_REFINER_MODEL=qwen2.5:7b-instruct
TRANSLATION_REFINER_TOKEN=
# HF_TOKEN=   # needed once to download the gated IndicTrans2 model
